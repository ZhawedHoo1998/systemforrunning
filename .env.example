# OpenAI credentials are loaded by the FastAPI backend only.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.aixhan.com/v1
OPENAI_TEXT_MODEL=gpt-5.6-sol
AI_WRITER_PROMPT_VERSION=xiaohongshu-v1
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_BASE_URL=
OPENAI_IMAGE_MODEL=
OPENAI_MAX_OUTPUT_TOKENS=3000
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=medium

# Optional absolute path when the xhs executable is not on the backend PATH.
# First-time login: xhs login --qrcode
XHS_CLI_PATH=

# Optional third-party public-data provider. Keep this key on the FastAPI backend.
# General auto syncing and competitor discovery use xiaohongshu-cli first.
# The daily owned-account monitor uses TikHub only for the 7-day metric window, with CLI fallback.
TIKHUB_API_KEY=
TIKHUB_BASE_URL=https://api.tikhub.io
XHS_PUBLIC_DATA_SOURCE=auto
XHS_ACCOUNT_SYNC_MAX_PAGES=10
XHS_CLI_REQUEST_DELAY_SECONDS=1.5
XHS_TIKHUB_REQUEST_DELAY_SECONDS=0.6
XHS_ACCOUNT_DETAIL_NOTES=8
XHS_OWNED_MONITOR_ENABLED=true
XHS_OWNED_MONITOR_TIMEZONE=Asia/Shanghai
XHS_OWNED_MONITOR_HOUR=9
XHS_OWNED_MONITOR_MAX_PAGES=3
XHS_OWNED_MONITOR_SOURCE=auto

# Xiaohongshu Open Platform shop integration.
XHS_OPEN_APP_ID=
XHS_OPEN_APP_SECRET=
XHS_OPEN_REDIRECT_URI=http://localhost:3000/account/xiaohongshu/callback
XHS_OPEN_API_BASE=https://ark.xiaohongshu.com
