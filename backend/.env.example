# Initial administrator. These values are only used when the users table is empty.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_DISPLAY_NAME=系统管理员
INITIAL_ADMIN_PASSWORD=RubyRain2026!

# Comma-separated frontend origins allowed to call the API with cookies.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Use true when the deployed site is served over HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_DAYS=14

# Optional absolute path when the xhs executable is not on the backend PATH.
# First-time login: xhs login --qrcode
XHS_CLI_PATH=

# Xiaohongshu Open Platform shop integration.
XHS_OPEN_APP_ID=
XHS_OPEN_APP_SECRET=
XHS_OPEN_REDIRECT_URI=http://localhost:3000/account/xiaohongshu/callback
XHS_OPEN_API_BASE=https://ark.xiaohongshu.com
